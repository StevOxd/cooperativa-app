# Configuración del Servidor
PORT=5000

# Configuración de Base de Datos PostgreSQL (macOS local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=stevenortiz
DB_PASSWORD=
DB_NAME=cooperativa_db

# Configuración de JWT (obligatoria; genere una con: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Conexión con el banco (banco-backend). La clave es obligatoria y debe ser la misma
# que BANCO_INTERNAL_API_KEY en banco-backend/.env (o en el .env de la raíz, con Docker).
BANCO_API_URL=http://localhost:5002
BANCO_INTERNAL_API_KEY=

# Configuración del Servicio de Correo Google Mail (Gmail SMTP)
# MAIL_ENABLED=false apaga todo envío de correo, aunque haya credenciales (útil para pruebas).
MAIL_ENABLED=true
MAIL_SERVICE=google
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Cooperativa Financiera <notificaciones@cooperativa.com>
