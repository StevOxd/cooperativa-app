PORT=5002
DB_HOST=localhost
DB_PORT=5432
# Rol de la aplicación (lee y escribe datos con los permisos que fijan las migraciones) y rol dueño de
# las tablas (solo para crear el esquema al arrancar). Los crea el servicio db-roles de
# Docker Compose: use los mismos valores del .env de la raíz.
DB_USER=cooperativa_app
DB_PASSWORD=
DB_OWNER_USER=cooperativa_owner
DB_OWNER_PASSWORD=
DB_NAME=banco_db
NODE_ENV=development
# Obligatoria; la misma que en backend/.env. Genere una con: openssl rand -hex 32
BANCO_INTERNAL_API_KEY=
