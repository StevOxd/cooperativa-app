# ==============================================================================
# Variables de Entorno para Docker Compose - Cooperativa
# Copie este archivo como .env en la raíz del proyecto antes de levantar los contenedores:
#   cp .env.example .env
# Compose lo lee solo: no hace falta --env-file.
#
# Las claves marcadas como OBLIGATORIA no traen valor: genere una propia con
#   openssl rand -hex 32
# Si falta alguna, docker compose se detiene y le indica cuál.
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración de Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
DB_NAME=cooperativa_db
DB_USER=cooperativa_user
# OBLIGATORIA. Se usa al crear la base por primera vez: si la cambia después,
# hay que recrear el volumen (docker compose down -v) o cambiarla dentro de PostgreSQL.
DB_PASSWORD=
DB_PORT=5432

# ------------------------------------------------------------------------------
# Nota macOS: El puerto 5000 suele estar reservado por Control Center (AirPlay Receiver).
# Usamos 5001 en el host para evitar conflictos.
BACKEND_PORT=5001
# OBLIGATORIA. Firma las sesiones del portal.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# OBLIGATORIA. Clave entre la cooperativa y el banco: la misma en backend y banco-backend.
BANCO_INTERNAL_API_KEY=

# ------------------------------------------------------------------------------
# Configuración de Frontend React Nginx
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Configuración del Servicio de Correo Google Mail (Gmail SMTP)
# ------------------------------------------------------------------------------
# Para generar tu contraseña de aplicación de Google de 16 caracteres:
# 1. Ingresa a https://myaccount.google.com/apppasswords con tu cuenta Google
# 2. Genera una contraseña para la aplicación (ej. "Cooperativa")
# 3. Pega la clave de 16 caracteres sin espacios en GMAIL_APP_PASSWORD
# MAIL_ENABLED=false apaga todo envío de correo, aunque haya credenciales (útil para pruebas).
MAIL_ENABLED=true
MAIL_SERVICE=google
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Cooperativa Financiera <notificaciones@cooperativa.com>
