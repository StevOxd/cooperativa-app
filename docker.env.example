# ==============================================================================
# Variables de Entorno para Docker Compose - Cooperativa
# Copia este archivo como .env en la raíz del proyecto antes de levantar los contenedores:
#   cp docker.env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración de Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
DB_NAME=cooperativa_db
DB_USER=cooperativa_user
DB_PASSWORD=cooperativa_secure_password_2026
DB_PORT=5432

# ------------------------------------------------------------------------------
# Nota macOS: El puerto 5000 suele estar reservado por Control Center (AirPlay Receiver).
# Usamos 5001 en el host para evitar conflictos.
BACKEND_PORT=5001
JWT_SECRET=super_secret_jwt_key_cooperativa_2026_seguridad_bancaria
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------------------
# Configuración de Frontend React Nginx
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
